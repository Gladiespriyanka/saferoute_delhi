# Pedestrian routing comes from OpenRouteService, which needs a free key.
# Get one at https://openrouteservice.org/dev/#/signup, then copy this file
# to .env.local and fill it in.
#
# You can also pass ?ors_key=YOUR_KEY once in the URL — it is remembered in
# localStorage after that, which is handy on a phone.
VITE_ORS_KEY=

# Optional: pin the backend instead of auto-detecting <this-host>:8000.
# VITE_API_BASE_URL=http://localhost:8000
